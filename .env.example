# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para '.env' e preencha com seus dados locais ou de produção:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. SERVIDOR & PROXY REVERSO (NGINX / OCI)
# ==============================================================================
ACTIVE_PROFILE=dev
PORT=8080

# Estratégia de cabeçalhos de rede encaminhados por Proxy Reverso (Nginx / OCI).
# 'framework': ativa o ForwardedHeaderFilter do Spring Boot para reconhecer
# X-Forwarded-For (IP real) e X-Forwarded-Proto (HTTPS seguro para cookies HttpOnly).
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ==============================================================================
# 2. BANCO DE DADOS (POSTGRESQL)
# ==============================================================================
# Execução local / Docker Compose:
POSTGRESSQL_URL=jdbc:postgresql://db:5432/tcc_db
POSTGRESSQL_USER=tcc_user
POSTGRESSQL_PASSWORD=tcc_pass

# Nota: O sistema também aceita os aliases SPRING_DATASOURCE_URL,
# SPRING_DATASOURCE_USERNAME e SPRING_DATASOURCE_PASSWORD.
# Em produção (OCI VM):
# POSTGRESSQL_URL=jdbc:postgresql://127.0.0.1:5432/tcc_db

# ==============================================================================
# 3. AUTENTICAÇÃO, SESSÃO & SEGURANÇA (JWT & COOKIES HTTPONLY)
# ==============================================================================
# Chave simétrica forte (mínimo 32 caracteres) para assinatura HMAC256 dos tokens JWT
JWT_SECRET=defina-uma-chave-secreta-forte-com-mais-de-32-caracteres-para-hmac256
JWT_ISSUER=pagtesouro-api
JWT_AUDIENCE=api
JWT_EXPIRATION_MINUTES=20

# Configurações de Cookie HttpOnly (SameSite=Lax fixo na mesma origem sob Nginx na OCI):
# Defina COOKIE_SECURE=true quando estiver servindo com HTTPS habilitado no Nginx
COOKIE_SECURE=false

# E-mail institucional que receberá permissão de ADMINISTRADOR (ADMIN) na inicialização
INITIAL_ADMIN_EMAIL=admin@ifnmg.edu.br

# Domínios autorizados no CORS (se o Nginx servir frontend e backend no mesmo domínio, pode ser restrito)
# Local: * ou http://localhost:3000
# Produção: https://pagamentos.salinas.ifnmg.edu.br
CORS_ALLOWED_ORIGINS=*

# ==============================================================================
# 4. ENVIO DE E-MAIL & RECUPERAÇÃO DE SENHA (SMTP)
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu-email-institucional@ifnmg.edu.br
SPRING_MAIL_PASSWORD=sua-senha-de-aplicativo-de-16-digitos
MAIL_FROM=nao-responda@ifnmg.edu.br

# URL pública da tela de redefinição de senha no frontend
# Local: http://localhost:3000/reset-password
# Produção: https://pagamentos.salinas.ifnmg.edu.br/reset-password
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# ==============================================================================
# 5. INTEGRAÇÃO COM A API DO PAGTESOURO (STN / SISGRU)
# ==============================================================================
# Ambiente de Homologação / Simulador:
PAGTESOURO_BASE_URL=https://valpagtesouro.tesouro.gov.br
# Ambiente de Produção da STN:
# PAGTESOURO_BASE_URL=https://pagtesouro.tesouro.gov.br

# Token de credenciamento oficial da Unidade Gestora (UG Salinas) fornecido pela STN
# (Também aceito sob a variável PAGTESOURO_TOKEN_SALINAS)
PAGTESOURO_TOKEN=insira_aqui_o_token_da_sua_unidade_gestora

# URL pública de notificação assíncrona da STN (Webhook - endpoint: /payments/webhook)
# AVISO: A STN exige domínio oficial (.gov.br ou .edu.br) sob HTTPS.
# Local / Testes: Deixe em branco para desabilitar o envio à STN durante o checkout.
# Produção (OCI): https://pagamentos.salinas.ifnmg.edu.br/payments/webhook
PAGTESOURO_URL_NOTIFICACAO=

# Domínios autorizados para o Webhook (STN oficial: .gov.br,.edu.br)
# Em testes com Simulador no Render e DuckDNS, adicione: .gov.br,.edu.br,duckdns.org,onrender.com
PAGTESOURO_NOTIFICATION_DOMAINS=.gov.br,.edu.br

# ==============================================================================
# 6. RESILIÊNCIA, DAEMON DE CONCILIAÇÃO & EXPIRAÇÃO
# ==============================================================================
# Frequência de execução do Daemon em segundo plano (Padrão: A cada 1 hora)
PAGTESOURO_DAEMON_CRON=0 0 * * * *

# Prazo limite em dias para cancelamento automático de pedidos pendentes abandonados
ORDER_ABANDONED_EXPIRATION_DAYS=10
