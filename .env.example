# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para '.env' e preencha com seus dados locais ou de homologação:
#   cp .env.example .env
# ==============================================================================

# Porta da aplicação
PORT=8080
ACTIVE_PROFILE=dev

# Conexão com o PostgreSQL (para execução via Docker Compose)
POSTGRESSQL_URL=jdbc:postgresql://db:5432/tcc_db
POSTGRESSQL_USER=tcc_user
POSTGRESSQL_PASSWORD=tcc_pass

# Segurança e Autenticação JWT
JWT_SECRET=defina-uma-chave-secreta-forte-com-mais-de-32-caracteres-para-hmac256
JWT_ISSUER=pagtesouro-api
JWT_AUDIENCE=api
JWT_EXPIRATION_MINUTES=20
CORS_ALLOWED_ORIGINS=*
INITIAL_ADMIN_EMAIL=admin@ifnmg.edu.br

# Integração com a API do PagTesouro (STN)
PAGTESOURO_BASE_URL=https://valpagtesouro.tesouro.gov.br
PAGTESOURO_TOKEN=insira_aqui_o_token_da_sua_unidade_gestora
PAGTESOURO_URL_NOTIFICACAO=http://localhost:8080/api/payments/webhook

# Daemon Failsafe e Expiração de Pedidos
PAGTESOURO_DAEMON_CRON=0 0 * * * *
ORDER_ABANDONED_EXPIRATION_DAYS=10
